REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=http://localhost:5000

# YouTube Data API v3 Key
# Получите ключ на https://console.cloud.google.com/
# 1. Создайте новый проект или выберите существующий
# 2. Включите "YouTube Data API v3" в Library
# 3. Создайте API ключ в Credentials
# 4. Скопируйте ключ и вставьте ниже
REACT_APP_YOUTUBE_API_KEY=your_youtube_api_key_here

# Квота YouTube API: 10,000 единиц в день
# Поиск видео: 100 единиц за запрос
# Получение деталей: 1 единица за видео
# Примерно 90-95 поисковых запросов в день
